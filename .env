# --- MQTT Configuration ---
# Use the service name defined in docker-compose.yml
MQTT_BROKER=iot_project_mosquitto_1
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=smartwell-backend

# --- Topic Logic ---
# These MUST match what the ESP32 is actually sending
# If ESP32 sends to: tubewell/ESP_01/telemetry
MQTT_COMMAND_TOPIC_PREFIX=tubewell
MQTT_TELEMETRY_TOPIC_SUFFIX=telemetry

# Quality of Service (0, 1, or 2)
MQTT_QOS=1